<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hoy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/w_hoy_accent"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="#4A93C6"
        android:text="" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_hoy_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRISAPLAN · HOY"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_hoy_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Todo al día"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2" />
        <TextView
            android:id="@+id/w_hoy_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Toca para gestionar"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
