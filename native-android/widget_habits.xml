<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hab_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/w_hab_accent"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="#10B981"
        android:text="" />
    <LinearLayout
        android:id="@+id/w_hab_text_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_hab_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BRISAPLAN · RACHAS"
            android:textColor="#6EE7B7"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_hab_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Racha activa"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <TextView
            android:id="@+id/w_hab_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Completa tus hábitos diarios"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>
    <TextView
        android:id="@+id/w_hab_check_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#10B981"
        android:text="✓ Marcar"
        android:textColor="#06281E"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
