<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hoy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BRISAPLAN • HOY" android:textColor="#93C5FD" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_hoy_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Todo al día" android:textColor="#F8FAFC" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" />
    <TextView android:id="@+id/w_hoy_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="Toca para gestionar" android:textColor="#94A3B8" android:textSize="12sp" android:maxLines="1" />
</LinearLayout>
