<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hab_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BRISAPLAN • RACHAS" android:textColor="#6EE7B7" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_hab_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Racha activa" android:textColor="#F8FAFC" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/w_hab_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="Completa tus hábitos diarios" android:textColor="#94A3B8" android:textSize="12sp" android:maxLines="1" />
</LinearLayout>
